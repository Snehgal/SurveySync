<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard | SurveySync </title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <header class="site-header">
        <div class="brand">
            <img src="/ece-logo.png" alt="IIIT-Delhi ECE">
            <span class="brand-divider" aria-hidden="true"></span>
            <div><strong>SurveySync</strong></div>
        </div>
        <a href="/" class="header-label">Analytics</a>
    </header>

    <main>
        <div class="page-heading">
            <h1>Response overview</h1>
            <p>Explore lab feedback and support outcomes across active sessions.</p>
        </div>
        <section class="filters" aria-label="Dashboard filters">
            <label><span>Room</span><select id="room">
                <option value="">Room Number</option>
                <% rooms.forEach(room => { %>
                    <option value="<%= room %>"><%= room %></option>
                <% }) %>
            </select></label>
            <label><span>Course</span><select id="course">
                <option value="">Course Code</option>
                <% courses.forEach(course => { %>
                    <option value="<%= course.split('-')[0] %>"><%= course.split('-')[0] %></option>
                <% }) %>
            </select></label>
            <label><span>Batch</span><select id="batch">
                <option value="">Batch</option>
                <% batches.forEach(batch => { %>
                    <option value="<%= batch %>"><%= batch %></option>
                <% }) %>
            </select></label>
            <label><span>Lab</span><select id="lab">
                <option value="">Lab Number</option>
                <% labs.forEach(lab => { %>
                    <option value="<%= lab %>"><%= lab %></option>
                <% }) %>
            </select></label>
            <section class="chart-toggle"><label><span>View</span>
                <select id="chartType">
                    <option value="bar">Bar</option>
                    <option value="pie">Pie</option>
                    <option value="doughnut">Doughnut</option>
                </select></label>
            </section>
            <button id="downloadBtn" aria-label="Download filtered records">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 5v14m0 0-5-5m5 5 5-5M5 19h14"></path>
                </svg>
                Export
            </button>
            
        </section>

        <section class="chart-card">
            <div class="chart-header"><div><span class="eyebrow">Distribution</span><h2>Feedback summary</h2></div><span class="live-badge">Live data</span></div>
            <div class="chart"><canvas id="chartCanvas"></canvas></div>
        </section>

        <div class="loading">Loading...</div>
    </main>

    <footer>
        <span>SurveySync</span><span>Department of Electronics &amp; Communications Engineering</span>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js" defer></script>

    <script src="/scripts.js"></script>
</body>
</html>
